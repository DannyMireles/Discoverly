# Supabase — your platform infra, never changes per-company
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption — used to store Lodgify keys and Stripe tokens encrypted in the DB
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Stripe — your platform account (Discoverly's), not the company's
# Companies connect their own Stripe via OAuth during onboarding
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Invite gate — companies must supply this token to create an account
# Generate with: openssl rand -base64 24
COMPANY_INVITE_TOKEN=
