# Supabase — your platform infra, never changes per-company
# Dashboard → Project Settings → API Keys: publishable (sb_publishable_...) and secret (sb_secret_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy JWT keys still work if set instead: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# App URLs — used in generated emails and public affiliate setup links
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_LODGIFY_PROMOTIONS_URL=https://app.lodgify.com
LODGIFY_PROMOTIONS_URL=https://app.lodgify.com

# Email — Resend sender for affiliate invites and owner setup notifications
RESEND_API_KEY=
INVITE_EMAIL_FROM=
OWNER_NOTIFICATION_EMAIL_FROM=

# Encryption — used to store Lodgify keys encrypted in the DB
# Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=

# Stripe — your platform account (Discoverly's), not the company's
# Companies connect their own Stripe through Stripe-hosted Connect onboarding
STRIPE_SECRET_KEY_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=

# Invite gate — companies must supply this token to create an account
# Generate with: openssl rand -base64 24
COMPANY_INVITE_TOKEN=
